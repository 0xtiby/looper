{
  "name": "@0xtiby/looper",
  "version": "0.1.0",
  "description": "Standalone AI loop orchestration engine",
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    }
  },
  "bin": {
    "looper": "./dist/cli.js"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "test": "vitest run --bail 1",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "lint": "biome check .",
    "format": "biome format --write ."
  },
  "keywords": [
    "ai",
    "cli",
    "loop",
    "orchestration",
    "claude",
    "codex"
  ],
  "author": "0xtiby",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/0xtiby/looper.git"
  },
  "bugs": {
    "url": "https://github.com/0xtiby/looper/issues"
  },
  "homepage": "https://github.com/0xtiby/looper#readme",
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "@0xtiby/spawner": "^1.2.1",
    "commander": "^14.0.3",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.4.12",
    "@j178/prek": "^0.3.9",
    "@types/node": "^25.6.0",
    "tsup": "^8.5.1",
    "typescript": "^6.0.2",
    "vitest": "^4.1.4"
  },
  "packageManager": "pnpm@10.28.1"
}
