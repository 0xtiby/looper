#!/usr/bin/env bash
# Usage: run_silent "description" command [args...]
# Success = ✓ description (3 tokens). Failure = full output for debugging.

desc="$1"; shift
output=$("$@" 2>&1)
exit_code=$?

if [ $exit_code -eq 0 ]; then
  echo "✓ $desc"
else
  echo "✗ $desc (exit $exit_code)"
  echo "$output"
fi

exit $exit_code
